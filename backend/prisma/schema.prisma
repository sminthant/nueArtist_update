generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PostStatus {
  draft
  published
}

model User {
  id              BigInt    @id @default(autoincrement())
  name            String
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  password        String
  role            String    @default("admin")
  rememberToken   String?   @map("remember_token")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  email     String    @id
  token     String
  createdAt DateTime? @map("created_at")

  @@map("password_reset_tokens")
}

model Album {
  id            BigInt    @id @default(autoincrement())
  title         String
  artistName    String?   @map("artist_name")
  coverImage    String?   @map("cover_image")
  category      String?
  spotifyUrl    String?   @map("spotify_url")
  soundcloudUrl String?   @map("soundcloud_url")
  youtubeUrl    String?   @map("youtube_url")
  isPublished   Boolean   @default(true) @map("is_published")
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@map("albums")
}

model Post {
  id            BigInt      @id @default(autoincrement())
  title         String
  content       String?     @db.Text
  image         String?
  instagramUrl  String?     @map("instagram_url")
  socialLink1   String?     @map("social_link_1")
  socialLink2   String?     @map("social_link_2")
  status        PostStatus  @default(draft)
  expireAt      DateTime?   @map("expire_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  @@index([expireAt])
  @@map("posts")
}

model Event {
  id          BigInt    @id @default(autoincrement())
  eventName   String    @map("event_name")
  venue       String?
  location    String?
  eventDate   DateTime? @map("event_date")
  posterImage String?   @map("poster_image")
  bookingUrl  String?   @map("booking_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("events")
}

model SocialLink {
  id        BigInt   @id @default(autoincrement())
  platform  String
  url       String
  icon      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_links")
}

model SampleLink {
  id         BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(150)
  directLink String    @map("direct_link") @db.Text
  image      String?
  price      Decimal   @default(0) @db.Decimal(10, 2)
  isActive   Boolean   @default(true) @map("is_active")
  order      Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([isActive])
  @@index([order])
  @@map("sample_links")
}

model ArtistBiography {
  id        BigInt    @id @default(autoincrement())
  title     String?
  content   String?   @db.Text
  image     String?
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("artist_biographies")
}
