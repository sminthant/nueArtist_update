# Supabase PostgreSQL — Connect → ORM → Prisma in dashboard
# Do NOT use db.[ref].supabase.co locally (IPv6-only → Prisma P1001).
# URL-encode password special chars: ! → %21

# Transaction pooler (runtime / Prisma Client)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30"

# Session pooler (prisma db push / migrate)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connect_timeout=30"

# Application
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Admin defaults (seed on `npm run seed:run` — also auto-created on backend boot)
ADMIN_NAME="Admin User"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
ADMIN_ROLE=admin

# Demo data seeder (backend folder):
#   npm run seed:run    — insert demo albums, posts, events, etc.
#   npm run seed:clear  — remove rows tagged with [SEED] prefix
#   npx prisma db seed  — same as seed:run

# File storage (local for now, Cloudflare R2 ready)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_URL=/storage

# Cloudflare R2 (future)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
